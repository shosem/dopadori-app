<% flash.each do |type, message| %>
  <% styles = type.to_sym == :alert ? "bg-alert border-alert-line text-alert-ink" : "bg-notice border-primary-soft text-notice-ink" %>
  <%# main の中に置くようになったので、画面幅いっぱいの帯ではなくカードとして出す %>
  <div role="status" class="mb-6 rounded-card border px-4 py-3 text-sm text-center <%= styles %>" data-turbo-temporary>
    <%= message %>
  </div>
<% end %>
