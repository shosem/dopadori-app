<%#
  ヘッダー。fixed なのは、衝動ボタン画面でここが唯一の「やめて戻る」導線になるため
  (あの画面はフッターナビを出さない)。スクロールで消えると逃げ道が消える。

  ロゴは Inter で出す。日本語の字形を持たないフォントなので、
  ラテン文字のここと数字だけが Inter の見え方になる(design_guideline.md)。
%>
<header class="fixed inset-x-0 top-0 z-40 border-b border-outline/40 bg-surface/80 pt-[env(safe-area-inset-top)] backdrop-blur-sm">
  <div class="mx-auto flex h-14 max-w-md items-center justify-between px-6">
    <%= link_to "Dopadori", root_path, class: "text-lg font-semibold tracking-tight text-primary" %>

    <%# 集中させる画面(衝動ボタン)では出さない。連打中に誤爆すると記録ごと失う %>
    <% unless focus_mode %>
      <%#
        account_circle ではなくログアウトの意味のアイコンにする。
        「アカウント関連の何か」を約束して取り消せない操作が起きるのを避けるため。
        メニューにしないのは、中身が1項目しか無いため(2026/08/13 決定)。
      %>
      <%= link_to destroy_user_session_path,
            data: { turbo_method: :delete, turbo_confirm: "ログアウトします" },
            aria: { label: "ログアウト" },
            class: "-mr-2 flex h-10 w-10 items-center justify-center rounded-full text-ink-sub transition-colors hover:bg-primary-soft/40" do %>
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor"
             stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 4.5H6.75a1.25 1.25 0 0 0-1.25 1.25v12.5a1.25 1.25 0 0 0 1.25 1.25H12"></path>
          <path d="M15.75 16.25 20 12l-4.25-4.25"></path>
          <path d="M20 12H9.5"></path>
        </svg>
      <% end %>
    <% end %>
  </div>
</header>
