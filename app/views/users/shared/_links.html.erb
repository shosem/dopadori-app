<%#
  Devise が生成した雛形から、有効にしていないモジュールの分岐を落とした。
  入れているのは database_authenticatable / rememberable / registerable / validatable だけなので、
  recoverable(パスワード再設定)・confirmable・lockable・omniauth の分岐は
  どれも到達しない(dev_schedule.md「明示的に切るもの」)。
%>

<p class="text-center text-sm text-ink-sub">
  <% if controller_name == "sessions" %>
    アカウントをお持ちでないですか?
    <%= link_to "はじめての方はこちら", new_registration_path(resource_name),
          class: "text-primary underline" %>
  <% else %>
    すでにアカウントをお持ちですか?
    <%= link_to "ログインはこちら", new_session_path(resource_name),
          class: "text-primary underline" %>
  <% end %>
</p>
