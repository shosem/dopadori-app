<div class="flex flex-col gap-6">
  <%# 一覧を読んでいる間もグラフを見えたままにする。
      一覧側を入れ子スクロールにする案は採らなかった(指がどちらの領域を掴んだか分からず、
      高さも 100dvh からの引き算になってグラフの高さが変わるたびに壊れるため)。
      top はヘッダー(h-14 + ノッチ)の真下。ヘッダーの高さを変えたらここも変わる。 %>
  <div class="sticky top-[calc(3.5rem+env(safe-area-inset-top))] z-10
              bg-card rounded-card border border-outline/40 p-6 flex flex-col gap-4">
    <div>
      <h2 class="text-ink text-base font-semibold">この1週間</h2>

      <p class="text-ink-sub text-sm">衝動が来た回数</p>
    </div>

    <%# グラフ %>
    <% max = @daily_counts.map { |day| day[:count] }.max %>

    <div class="grid grid-cols-7 gap-2.5 items-end">
      <% @daily_counts.each do |day| %>
        <% today = day[:date] == Time.zone.today %>

        <div class="flex flex-col items-center gap-2">
          <div class="h-24 w-full flex items-end justify-center">
            <%# 高さは実行時に決まるため Tailwind のクラスでは書けない(ビルド時のスキャンに乗らない)。
                0 の日を先に分岐させているので、この式で max が 0 になることはない。 %>
            <% if day[:count].zero? %>
              <div class="h-[3px] w-3.5 rounded-full bg-outline/70"></div>
            <% else %>
              <div class="w-3.5 rounded-full <%= today ? "bg-primary-soft" : "bg-primary" %>"
                   style="height: <%= day[:count] * 100 / max %>%"></div>
            <% end %>
          </div>

          <span class="text-xs <%= today ? "text-primary font-semibold" : "text-ink-sub" %>">
            <%= today ? "今日" : day[:date].day %>
          </span>
        </div>
      <% end %>
    </div>
  </div>

  <%# 記録一覧。記録が0件の日は行を出さない(0はグラフ側が見せているので、
      一覧に「記録なし」を並べると宿題を突きつけることになる)。 %>
  <% if @urges_by_date.empty? %>
    <div class="flex flex-col items-center gap-1.5 py-8 text-center">
      <p class="text-base text-ink">まだ記録がありません</p>

      <p class="text-sm text-ink-sub">ホームから記録できます</p>
    </div>
  <% else %>
    <%# 行がリンクであることは見た目に出ていないので、言葉で補う。
        矢印の意味までは説明しない(詳細画面を開けば「我慢できなかった」と書いてある)。 %>
    <p class="-mt-2 text-xs text-ink-sub">記録をタップすると詳細を開けます</p>

    <div class="flex flex-col gap-5">
      <% @urges_by_date.each do |date, urges| %>
        <section>
          <div class="mb-2 flex items-baseline justify-between border-b border-outline/45 pb-1.5">
            <h2 class="text-sm font-semibold text-ink tabular-nums">
              <%= date.month %>月<%= date.day %>日(<%= t("date.abbr_day_names")[date.wday] %>)
            </h2>

            <span class="text-xs text-ink-sub"><%= urges.size %>回</span>
          </div>

          <%# 行の間だけに線を引きたいので、各行に border を付けず親で divide-y を使う %>
          <div class="divide-y divide-outline/25">
            <% urges.each do |urge| %>
              <%# 代替行動を選んだ記録は、メモよりも「何をしたか」を出す %>
              <% detail = urge.took_action? ? urge.alternative_action&.title : urge.memo %>

              <%# 行ごとリンクにする。チップだけを押させると指に対して的が小さい。
                  最後の列は gave_in の印の指定席で、印が無い行も幅を空けておく
                  (有る行だけ列が伸び縮みすると、時刻とチップの位置が行ごとにずれる)。 %>
              <%= link_to urge_path(urge),
                    class: "grid grid-cols-[auto_auto_1fr_1.25rem] items-center gap-2.5 py-3" do %>
                <span class="text-sm text-ink-sub tabular-nums">
                  <%= urge.created_at.strftime("%H:%M") %>
                </span>

                <%= render "urges/resolved_chip", resolved: urge.resolved %>

                <%# min-w-0 が無いと、長いメモがグリッドの枠を突き破ってカードごと横に広がる %>
                <span class="min-w-0 truncate text-sm text-ink-sub"><%= detail %></span>

                <span class="flex justify-center">
                  <% if urge.gave_in? %>
                    <%# 意味を持たない印にする。矢印や目のような「絵」は、20px では潰れるか、
                        別の記号(別タブで開く・閲覧)と誤読される。丸なら壊れようがなく、
                        価値判断も持たない。何の印かは詳細画面が言う。 %>
                    <span class="h-2 w-2 rounded-full bg-primary"
                          role="img" aria-label="我慢できなかった"></span>
                  <% end %>
                </span>
              <% end %>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  <% end %>
</div>
